  async function execute(raw: string) {
    if (busy) return
    busy = true
    refocus = true
    removeIdlePrompt()
    addCommandLine(raw)
    const text = raw.trim()
    if (text) session.typedHistory = [...(session.typedHistory || []), text]
    const [first, ...rest] = text.split(/\s+/)
    const expanded = aliases[first] ? [...aliases[first].split(' '), ...rest] : [first, ...rest]
    const [name, ...args] = expanded
    let result: Result = 'done'
    if (!text) {
      // just a new prompt
    } else if (commands[name]) {
      result = await commands[name](args)
    } else if (/^(\.\/|~\/|\/)/.test(name) && name.endsWith('.sh')) {
      if (!(await runScript(name))) printError(`balpars-sh: ${name}: No such file or directory`)
    } else if (jokes[name]) {
      print(escapeHtml(jokes[name]))
    } else {
      printError(`balpars-sh: ${name}: command not found (try help)`)
    }
    if (result === 'navigating') return
    saveSession()
    showIdlePrompt()
    busy = false
  }

  function clearScreen() {
    session.lines = []
    if (screen) screen.innerHTML = ''
    saveSession()
  }

  // ---------------------------------------------------------------- automatic typing

  // Types a command at the prompt, then "presses Enter"
  async function run(step: Step) {
    const p = document.createElement('p')
    p.innerHTML = `<span class="prompt">${escapeHtml(session.cwd)} $</span> `
    const typed = document.createElement('span')
    typed.className = 'typing'
    p.append(typed)
    screen?.append(p)
    scrollToEnd()
    await wait(between(100, 180))
    // Long names are tab-completed like in a real shell: type the first few
    // letters of the last word, pause, then the rest appears at once
    const lastWord = Math.max(step.text.lastIndexOf(' '), step.text.lastIndexOf('/')) + 1
    const typedPart =
      step.text.length > 18 ? step.text.slice(0, Math.min(lastWord + 4, step.text.length)) : step.text
    for (const char of typedPart) {
      typed.textContent += char
      await wait(/[ ./_~-]/.test(char) ? between(60, 110) : between(28, 60))
    }
    if (typedPart !== step.text) {
      await wait(between(110, 170))
      typed.textContent = step.text
    }
    await wait(between(100, 160))
    typed.className = ''
    session.lines.push({ kind: 'cmd', cwd: session.cwd, text: step.text })
    if (step.cwd) session.cwd = step.cwd
    setTitle()
  }

  // Splits the page into blocks small enough to print one after another
  function printableBlocks(root: Element, depth = 0): HTMLElement[] {
    const children = [...root.children].filter(
      (el): el is HTMLElement => el instanceof HTMLElement && !el.matches('script, style, template'),
    )
    return children.flatMap((el) => {
      const container =
        el.matches('div, section, article, ul, ol') &&
        !el.matches('.expressive-code, figure, .toc, aside, nav') &&
        el.children.length > 1 &&
        depth < 4
      return container ? printableBlocks(el, depth + 1) : [el]
    })
  }

  // Prints the page content top to bottom, like command output
  async function printContent() {
    const root = document.documentElement
    const main = document.querySelector('main')
    if (!main || !root.classList.contains('term-printing')) return
    const blocks = printableBlocks(main)
    blocks.forEach((block) => (block.style.visibility = 'hidden'))
    root.classList.remove('term-printing')
    for (const [index, block] of blocks.entries()) {
      block.style.visibility = ''
      if (index < 24) await wait(30)
    }
  }

  async function runHomeExtras() {
    const isHome = (location.pathname.replace(/^\/tr(?=\/|$)/, '') || '/') === '/'
    if (!isHome || session.homeDone) return
    session.homeDone = true
    await wait(500)
    await run({ text: 'tail journey.log' })
    for (const post of fs.posts.slice(0, 5)) {
      print(`<span class="log-date">[${post.date}]</span> ${postLink(post.slug, post.title)}`)
      await wait(between(25, 60))
    }
  }

  // Easter egg, once per browser session. Waits while the reader is typing.
  function scheduleEgg(key: 'bitcoinShown', delay: number, script: string) {
    if (session[key]) return
    setTimeout(async function attempt() {
      if (session[key]) return
      if (busy || currentInput()?.value) return setTimeout(attempt, 15_000)
      busy = true
      session[key] = true
      const hadFocus = document.activeElement === currentInput()
      removeIdlePrompt()
      await run({ text: script })
      await runScript(script)
      saveSession()
      refocus = hadFocus
      showIdlePrompt()
      busy = false
    }, delay)
  }

  async function start() {
    if (!terminal || !screen || !fs) return
    session.lines.forEach((line) => screen.append(lineElement(line)))
    setTitle()
    scrollToEnd()
    busy = true
    // Arriving from a click or a typed command: it was already typed on the previous page
    const arrivedByClick = session.pending === location.pathname
    session.pending = undefined
    refocus = Boolean(session.keepFocus)
    session.keepFocus = false
    if (!arrivedByClick) {
      const steps = stepsFor(location.pathname, session.cwd)
      // After a reload the last command is already this page's; don't type it twice
      const lastCommand = [...session.lines].reverse().find((line) => line.kind === 'cmd')
      const alreadyRan = steps.length > 0 && lastCommand?.text === steps[steps.length - 1].text
      for (const step of steps) {
        if (alreadyRan) {
          if (step.cwd) session.cwd = step.cwd
        } else await run(step)
      }
      setTitle()
    }
    if (document.querySelector('[data-not-found]')) {
      const path = location.pathname.replace(/\/$/, '')
      printError(`bash: cd: ~${path}: No such file or directory`)
    }
    await printContent()
    await runHomeExtras()
    saveSession()
    showIdlePrompt()
    busy = false
    scheduleEgg('bitcoinShown', BITCOIN_DELAY, './mine_bitcoin.sh')
  }

  // Clicking a link on the site types its command first, then navigates
  async function navigate(url: URL) {
    busy = true
    session.keepFocus = document.activeElement === currentInput()
    removeIdlePrompt()
    const rect = terminal!.getBoundingClientRect()
    if (rect.bottom < 0 || rect.top > window.innerHeight) {
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })
      await wait(400)
    }
    for (const step of stepsFor(url.pathname, session.cwd)) await run(step)
    session.pending = url.pathname
    saveSession()
    window.location.href = url.href
  }

  document.addEventListener('click', (event) => {
    if (!terminal || event.defaultPrevented || event.button !== 0) return
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
    const link = (event.target as Element).closest?.('a')
    if (!link || (link.target && link.target !== '_self') || link.hasAttribute('download')) return
    if (link.closest('dialog')) return
    const url = new URL(link.href, location.href)
    if (url.origin !== location.origin) return
    if (url.pathname === location.pathname && url.hash) return
    if (/\.\w+$/.test(url.pathname)) return // rss.xml and other files
    event.preventDefault()
    if (url.pathname === location.pathname) {
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })
      return
    }
    if (busy) return
    navigate(url)
  })

  // Clicking the terminal (but not a link in it) puts the cursor in the prompt.
  // While the terminal is still typing there is no prompt yet: remember the click
  // and focus the prompt as soon as it appears.
  terminal?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a') || window.getSelection()?.toString()) return
    const input = currentInput()
    if (input) input.focus({ preventScroll: true })
    else refocus = true
  })

  // Keep what the reader types in that short wait, instead of dropping it
  document.addEventListener('keydown', (event) => {
    if (!refocus || currentInput() || event.ctrlKey || event.metaKey || event.altKey) return
    if (event.key.length === 1) pendingKeys += event.key
    else if (event.key === 'Backspace') pendingKeys = pendingKeys.slice(0, -1)
    else return
    event.preventDefault()
  })

  // Theme changes from the palette menu show up as a command too
  new MutationObserver(async () => {
    if (quietThemeChange) {
      quietThemeChange = false
      return
    }
    if (busy) return
    busy = true
    const hadFocus = document.activeElement === currentInput()
    removeIdlePrompt()
    await run({ text: `theme ${document.documentElement.getAttribute('data-theme')}` })
    saveSession()
    refocus = hadFocus
    showIdlePrompt()
    busy = false
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })

  start()
</script>

<style>
  .terminal {
    margin-top: 1.25rem;
    height: 14rem;
    display: flex;
    flex-direction: column;
    font-size: 0.75rem;
    line-height: 1.5;
    font-variant-ligatures: none;
    border: 1px solid color-mix(in srgb, var(--theme-foreground) 10%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--theme-background) 92%, var(--theme-foreground));
    overflow: hidden;
    cursor: text;
  }

  /* Narrow screens: docked to the bottom of the screen, always in view */
  @media (max-width: 767px) {
    .terminal {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      margin: 0;
      height: calc(7.5rem + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      border-bottom: none;
      border-radius: 10px 10px 0 0;
      box-shadow: 0 -10px 30px rgb(0 0 0 / 0.35);
    }
  }

  .terminal-bar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 5px;
    padding: 6px 10px;
    background: color-mix(in srgb, var(--theme-foreground) 6%, transparent);

    span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--theme-foreground) 20%, transparent);
    }

    em {
      margin-left: auto;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      font-style: normal;
      color: color-mix(in srgb, var(--theme-foreground) 45%, transparent);
    }
  }

  .terminal-screen {
    flex: 1;
    padding: 8px 10px 10px;
    overflow-y: auto;
    scrollbar-width: none;
    color: color-mix(in srgb, var(--theme-foreground) 80%, transparent);
  }
</style>

<style is:global>
  /* Lines in the terminal are added by the script, so they are styled globally */
  .terminal-screen p {
    margin: 0 0 2px;
    overflow-wrap: anywhere;
  }

  .terminal-screen .prompt,
  .terminal-screen .log-date,
  .terminal-screen .cursor,
  .terminal-screen .dir,
  .terminal-screen .typing::after {
    color: var(--theme-accent);
  }

  .terminal-screen .log-date {
    opacity: 0.75;
  }

  .terminal-screen .pre {
    white-space: pre-wrap;
  }

  .terminal-screen .comment {
    opacity: 0.55;
  }

  .terminal-screen .soldiers {
    white-space: pre;
  }

  .terminal-screen .castle {
    margin: 0;
    line-height: 1.2;
    white-space: pre;
    overflow-wrap: normal;
    color: color-mix(in srgb, var(--theme-accent) 55%, transparent);
  }

  .terminal-screen .error {
    color: var(--theme-caution);
  }

  .terminal-screen a {
    color: inherit;
    text-decoration: none;
  }

  .terminal-screen a:hover {
    color: var(--theme-accent);
    text-decoration: underline;
  }

  .terminal-screen .typing::after {
    content: '▌';
  }

  /* The prompt you can type into */
  .terminal-screen .idle {
    display: flex;
    align-items: baseline;
    gap: 1ch;
  }

  .terminal-screen .line-input {
    position: relative;
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Receives the keys but stays invisible; what you see is the mirror and the block */
  .terminal-screen .term-input {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: none;
    outline: none !important;
    background: transparent;
    color: transparent;
    caret-color: transparent;
    font: inherit;
    opacity: 0;
  }

  .terminal-screen .cursor {
    animation: terminal-blink 1.1s steps(1) infinite;
  }

  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-screen .cursor {
      animation: none;
    }
  }

  /* Room at the end of the page for the docked terminal, and the scroll-up
     button moves above it */
  @media (max-width: 767px) {
    body:has([data-terminal]) {
      padding-bottom: calc(8rem + env(safe-area-inset-bottom));
    }

    body:has([data-terminal]) .scroll-up {
      bottom: calc(8.5rem + env(safe-area-inset-bottom));
    }
  }

  /* Set in <head> before the page paints; the terminal script prints the content
     and removes it. The head script also removes it after a few seconds as a fallback. */
  html.term-printing main {
    visibility: hidden;
  }
</style>
