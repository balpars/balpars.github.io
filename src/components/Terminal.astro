---
// One terminal for the whole site, under the menu on every page.
// - Every page "runs" its command here before its content is printed
//   (cd ~/posts, cat post.md, ...), and the history carries over between pages.
// - Clicking a link types the matching command before navigating.
// - Readers can type too. It is a deliberately tiny shell over a fixed, fake file
//   system (posts, tags, series, about.md); cd/cat to a page behaves exactly
//   like clicking its link. Nothing typed here runs anywhere.
// - On narrow screens it docks to the bottom of the screen like a game console.
// - Easter egg: 2 minutes on a page runs ./mine_bitcoin.sh (only prints text).
//   The castle (./castle_age.sh) shows up when someone "attacks" the shell.
import siteConfig from '~/site.config'
import { getLangFromUrl, localizePath } from '~/i18n'
import { SeriesGroup, TagsGroup, dateString, getSortedPosts, postSlug } from '~/utils'

const lang = getLangFromUrl(Astro.url)
const posts = await getSortedPosts(lang)
const tags = await TagsGroup.build(posts, lang)
const series = await SeriesGroup.build(posts, lang)

// The fake file system the shell works on, embedded as JSON for the script
const fs = {
  langPrefix: localizePath('/', lang).replace(/\/$/, ''),
  posts: [...posts].reverse().map((post) => ({
    slug: postSlug(post),
    title: post.data.title,
    date: dateString(post.data.published),
    // Byte size of the markdown source, shown by `ls -l`
    size: new TextEncoder().encode(post.body ?? '').length,
  })),
  tags: tags.collations.map((tag) => ({
    slug: tag.titleSlug,
    posts: tag.entries.map(postSlug),
  })),
  series: series.collations.map((item) => ({
    slug: item.titleSlug,
    posts: item.entries.map(postSlug),
  })),
  themes: siteConfig.themes.mode === 'select' ? siteConfig.themes.include : [],
  castle: [
    '    |>>           |>>',
    '    |             |',
    '   /^\\           /^\\',
    '  /___\\         /___\\',
    '  |   |_^_^_^_^_|   |',
    '  | o |         | o |',
    '  |   |   ___   |   |',
    '  |   |  |   |  |   |',
    '__|___|__|   |__|___|__',
  ],
}
// Keep "</script>" in a title from ending the JSON block early
const fsJson = JSON.stringify(fs).replace(/</g, '\\u003c')
---

<div class="terminal" data-terminal>
  <div class="terminal-bar" aria-hidden="true">
    <span></span><span></span><span></span>
    <em class="terminal-title">balpars@journey: ~</em>
  </div>
  <div class="terminal-screen" role="log" aria-label="Terminal"></div>
  <script is:inline type="application/json" data-terminal-fs set:html={fsJson} />
</div>

<script>
  type Line = { kind: 'cmd'; cwd: string; text: string } | { kind: 'out'; html: string; cls?: string }
  type Step = { text: string; cwd?: string }
  type Session = {
    lines: Line[]
    cwd: string
    pending?: string
    homeDone?: boolean
    bitcoinShown?: boolean
    typedHistory?: string[]
    // The reader was typing in the terminal when they left the previous page
    keepFocus?: boolean
  }
  type Fs = {
    langPrefix: string
    posts: { slug: string; title: string; date: string; size: number }[]
    tags: { slug: string; posts: string[] }[]
    series: { slug: string; posts: string[] }[]
    themes: string[]
    castle: string[]
  }

  const STORAGE_KEY = 'terminal-session'
  const MAX_LINES = 80
  const BITCOIN_DELAY = 120_000

  const terminal = document.querySelector<HTMLElement>('[data-terminal]')
  const screen = terminal?.querySelector<HTMLElement>('.terminal-screen')
  const title = terminal?.querySelector<HTMLElement>('.terminal-title')
  const fs: Fs = JSON.parse(terminal?.querySelector('[data-terminal-fs]')?.textContent || 'null')
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, reduced ? 0 : ms))
  const between = (min: number, max: number) => min + Math.random() * (max - min)
  const escapeHtml = (text: string) =>
    text.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)

  function loadSession(): Session {
    try {
      const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || 'null')
      if (saved && Array.isArray(saved.lines)) return saved
    } catch {}
    return { lines: [], cwd: '~' }
  }

  const session = loadSession()
  let busy = false
  let refocus = false
  // Keys typed after clicking the terminal but before the prompt is back
  let pendingKeys = ''
  let quietThemeChange = false

  function saveSession() {
    session.lines = session.lines.slice(-MAX_LINES)
    session.typedHistory = (session.typedHistory || []).slice(-50)
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(session))
    } catch {}
  }

  // ---------------------------------------------------------------- the fake file system

  const scripts = ['castle_age.sh', 'mine_bitcoin.sh']

  // "~/tags/../posts" -> "~/posts". "/" is treated as home, there is nothing above it.
  function resolvePath(arg: string, cwd: string): string {
    const parts = arg.startsWith('~')
      ? arg.slice(1).split('/')
      : arg.startsWith('/')
        ? arg.split('/')
        : [...cwd.slice(1).split('/'), ...arg.split('/')]
    const stack: string[] = []
    for (const part of parts) {
      if (!part || part === '.') continue
      if (part === '..') stack.pop()
      else stack.push(part)
    }
    return '~' + (stack.length ? '/' + stack.join('/') : '')
  }

  // Directory listing, or null when the directory doesn't exist.
  // `hidden` files only show up with `ls -a`.
  function listDir(dir: string): { dirs: string[]; files: string[]; hidden?: string[] } | null {
    const postFiles = (slugs: string[]) => slugs.map((slug) => `${slug}.md`)
    if (dir === '~') {
      return {
        dirs: ['posts', 'tags', 'series'],
        files: ['about.md', 'journey.log', ...scripts],
        hidden: Object.keys(dotfiles),
      }
    }
    if (/^~\/posts(\/\d+)?$/.test(dir)) return { dirs: [], files: postFiles(fs.posts.map((p) => p.slug)) }
    if (dir === '~/tags') return { dirs: fs.tags.map((t) => t.slug), files: [] }
    if (dir === '~/series') return { dirs: fs.series.map((s) => s.slug), files: [] }
    const tag = dir.match(/^~\/tags\/([^/]+)(\/\d+)?$/)
    const found = tag && fs.tags.find((t) => t.slug === tag[1])
    if (found) return { dirs: [], files: postFiles(found.posts) }
    const item = dir.match(/^~\/series\/([^/]+)$/)
    const seriesFound = item && fs.series.find((s) => s.slug === item[1])
    if (seriesFound) return { dirs: [], files: postFiles(seriesFound.posts) }
    return null
  }

  // The page a directory stands for, if it has one
  function dirPage(dir: string): string | null {
    if (dir === '~') return '/'
    if (dir === '~/posts') return '/posts'
    if (/^~\/posts\/\d+$/.test(dir)) return dir.slice(1)
    if (/^~\/(tags|series)\/[^/]+(\/\d+)?$/.test(dir) && listDir(dir)) return dir.slice(1)
    return null
  }

  function splitPath(path: string) {
    const index = path.lastIndexOf('/')
    return { dir: path.slice(0, index), name: path.slice(index + 1) }
  }

  // ---------------------------------------------------------------- screen

  // The commands a page "runs", based on its path (Turkish pages use the same paths)
  function stepsFor(pathname: string, cwd: string): Step[] {
    const path = pathname.replace(/^\/tr(?=\/|$)/, '').replace(/\/$/, '') || '/'
    const cd = (dir: string): Step[] => (cwd === dir ? [] : [{ text: `cd ${dir}`, cwd: dir }])
    let match
    if (document.querySelector('[data-not-found]') && pathname === location.pathname) {
      return [{ text: `cd ~${path}` }]
    }
    if (path === '/') return cd('~')
    if (path === '/about') return [{ text: cwd === '~' ? 'cat about.md' : 'cat ~/about.md' }]
    if (path === '/posts') return cd('~/posts')
    if ((match = path.match(/^\/posts\/(\d+)$/))) return cd(`~/posts/${match[1]}`)
    if ((match = path.match(/^\/posts\/([^/]+)$/))) return [...cd('~/posts'), { text: `cat ${match[1]}.md` }]
    if ((match = path.match(/^\/tags\/([^/]+)(?:\/(\d+))?$/))) return cd(`~/tags/${match[1]}${match[2] ? '/' + match[2] : ''}`)
    if ((match = path.match(/^\/series\/([^/]+)$/))) return cd(`~/series/${match[1]}`)
    return cd(`~${path}`)
  }

  function lineElement(line: Line) {
    const p = document.createElement('p')
    p.innerHTML =
      line.kind === 'cmd'
        ? `<span class="prompt">${escapeHtml(line.cwd)} $</span> ${escapeHtml(line.text)}`
        : line.html
    if (line.kind === 'out') p.className = ['output', line.cls].filter(Boolean).join(' ')
    return p
  }

  function scrollToEnd() {
    if (screen) screen.scrollTop = screen.scrollHeight
  }

  function setTitle() {
    if (title) title.textContent = `balpars@journey: ${session.cwd}`
  }

  function print(html: string, cls?: string) {
    const line: Line = { kind: 'out', html, cls }
    session.lines.push(line)
    screen?.append(lineElement(line))
    scrollToEnd()
  }

  function printError(text: string) {
    print(`<span class="error">${escapeHtml(text)}</span>`)
  }

  function addCommandLine(text: string) {
    const line: Line = { kind: 'cmd', cwd: session.cwd, text }
    session.lines.push(line)
    screen?.append(lineElement(line))
    scrollToEnd()
  }

  const postLink = (slug: string, label: string) =>
    `<a href="${fs.langPrefix}/posts/${encodeURIComponent(slug)}/" tabindex="-1">${escapeHtml(label)}</a>`

  // ---------------------------------------------------------------- prompt and input

  let historyIndex = 0

  function showIdlePrompt() {
    removeIdlePrompt()
    const p = document.createElement('p')
    p.className = 'idle'
    // The real input is invisible; the typed text is mirrored in front of a block
    // cursor, so it looks like a terminal whether or not the input has focus
    p.innerHTML =
      `<span class="prompt">${escapeHtml(session.cwd)} $</span>` +
      `<span class="line-input"><span class="mirror"></span><span class="cursor" aria-hidden="true">▌</span>` +
      `<input class="term-input" aria-label="Terminal command, type help" spellcheck="false" autocomplete="off" autocapitalize="off" /></span>`
    screen?.append(p)
    const input = p.querySelector('input')!
    input.addEventListener('keydown', onKeyDown)
    input.addEventListener('input', () => syncMirror(input))
    historyIndex = (session.typedHistory || []).length
    if (refocus) {
      input.focus({ preventScroll: true })
      input.value = pendingKeys
      syncMirror(input)
    }
    refocus = false
    pendingKeys = ''
    scrollToEnd()
  }

  function removeIdlePrompt() {
    screen?.querySelector('.idle')?.remove()
  }

  function currentInput() {
    return screen?.querySelector<HTMLInputElement>('.term-input') || null
  }

  function syncMirror(input: HTMLInputElement) {
    const mirror = input.parentElement?.querySelector('.mirror')
    if (mirror) mirror.textContent = input.value
    scrollToEnd()
  }

  function onKeyDown(event: KeyboardEvent) {
    const input = event.target as HTMLInputElement
    const history = session.typedHistory || []
    if (event.key === 'Enter') {
      event.preventDefault()
      execute(input.value)
    } else if (event.key === 'Tab') {
      event.preventDefault()
      complete(input)
    } else if (event.key === 'ArrowUp' && history.length) {
      event.preventDefault()
      historyIndex = Math.max(0, historyIndex - 1)
      input.value = history[historyIndex] || ''
    } else if (event.key === 'ArrowDown' && history.length) {
      event.preventDefault()
      historyIndex = Math.min(history.length, historyIndex + 1)
      input.value = history[historyIndex] || ''
    } else if (event.key === 'Escape') {
      input.blur()
    } else if (event.key === 'l' && event.ctrlKey) {
      event.preventDefault()
      clearScreen()
      refocus = true
      showIdlePrompt()
    } else if (event.key === 'c' && event.ctrlKey && input.selectionStart === input.selectionEnd) {
      event.preventDefault()
      addCommandLine(input.value + '^C')
      refocus = true
      showIdlePrompt()
    }
    syncMirror(input)
  }

  // Tab completion over commands and the fake file system
  function complete(input: HTMLInputElement) {
    const value = input.value
    const lastSpace = value.lastIndexOf(' ')
    let candidates: string[]
    let prefix: string
    if (lastSpace === -1) {
      prefix = value
      const local = session.cwd === '~' ? scripts.map((s) => `./${s}`) : []
      candidates = [...Object.keys(commands), ...Object.keys(aliases), ...local].filter((c) =>
        c.startsWith(prefix),
      )
    } else {
      prefix = value.slice(lastSpace + 1)
      const slash = prefix.lastIndexOf('/')
      const dirPart = slash === -1 ? '' : prefix.slice(0, slash + 1)
      const listing = listDir(dirPart ? resolvePath(dirPart, session.cwd) : session.cwd)
      const namePart = prefix.slice(dirPart.length)
      const hidden = namePart.startsWith('.') ? listing?.hidden || [] : []
      const entries = listing ? [...listing.dirs.map((d) => d + '/'), ...listing.files, ...hidden] : []
      candidates = entries.filter((e) => e.startsWith(namePart)).map((e) => dirPart + e)
    }
    if (!candidates.length) return
    let common = candidates[0]
    for (const candidate of candidates) {
      while (!candidate.startsWith(common)) common = common.slice(0, -1)
    }
    if (candidates.length === 1 && !common.endsWith('/')) common += ' '
    if (common.length > prefix.length) {
      input.value = value.slice(0, value.length - prefix.length) + common
      syncMirror(input)
    } else if (candidates.length > 1) {
      // Second Tab in a real shell: show the options
      addCommandLine(value)
      print(escapeHtml(candidates.map((c) => c.slice(c.lastIndexOf('/', c.length - 2) + 1)).join('  ')))
      refocus = true
      showIdlePrompt()
      const fresh = currentInput()
      if (fresh) {
        fresh.value = value
        syncMirror(fresh)
      }
    }
  }

  // ---------------------------------------------------------------- commands

  type Result = 'done' | 'navigating'

  // Leaves for another page the same way a click does: the command is already typed
  function goTo(path: string): Result {
    // Pages live at folder URLs: "/posts/x/", "/tr/", "/"
    const joined = fs.langPrefix + path
    const target = joined.endsWith('/') ? joined : `${joined}/`
    if (target === location.pathname) return 'done'
    session.pending = target
    session.keepFocus = true
    saveSession()
    window.location.href = target
    return 'navigating'
  }

  type Entry = { name: string; kind: 'dir' | 'file' }

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  const postDate = (slug: string) => fs.posts.find((p) => p.slug === slug)?.date || ''
  const newestDate = (slugs?: string[]) =>
    (slugs ? slugs.map(postDate) : fs.posts.map((p) => p.date)).sort().pop() || '1970-01-01'
  const oldestDate = () => fs.posts.map((p) => p.date).sort()[0] || '1970-01-01'

  // "2026-11-01" -> "Nov  1  2026", the way ls shows older files
  function lsDate(iso: string) {
    const [year, month, day] = iso.split('-').map(Number)
    return `${MONTHS[month - 1]} ${String(day).padStart(2)}  ${year}`
  }

  // 4096 -> "4.0K", 12800 -> "13K", like ls -h
  function humanSize(bytes: number) {
    if (bytes < 1024) return String(bytes)
    let value = bytes / 1024
    let unit = 0
    while (value >= 1024 && unit < 2) {
      value /= 1024
      unit++
    }
    return (value < 10 ? value.toFixed(1) : String(Math.round(value))) + ['K', 'M', 'G'][unit]
  }

  // What ls -l reports for an entry of the fake file system
  function stat(dir: string, entry: Entry) {
    const path = entry.name === '.' ? dir : entry.name === '..' ? splitPath(dir).dir || '~' : `${dir}/${entry.name}`
    if (entry.kind === 'dir') {
      const subdirs = entry.name === '..' && dir === '~' ? 1 : listDir(path)?.dirs.length || 0
      const tag = path.match(/^~\/tags\/([^/]+)/)
      const item = path.match(/^~\/series\/([^/]+)/)
      const slugs = tag
        ? fs.tags.find((t) => t.slug === tag[1])?.posts
        : item
          ? fs.series.find((s) => s.slug === item[1])?.posts
          : undefined
      const isRoot = entry.name === '..' && dir === '~'
      return {
        mode: 'drwxr-xr-x',
        links: 2 + subdirs,
        owner: isRoot ? 'root' : 'balpars',
        size: 4096,
        date: newestDate(slugs),
      }
    }
    const name = entry.name
    const file = (mode: string, size: number, date: string) => ({ mode, links: 1, owner: 'balpars', size, date })
    const post = fs.posts.find((p) => `${p.slug}.md` === name)
    if (post) return file('-rw-r--r--', post.size, post.date)
    if (name === 'about.md') return file('-rw-r--r--', 1337, newestDate())
    if (name === 'journey.log') {
      const log = fs.posts.slice(0, 5).map((p) => `[${p.date}] ${p.title}\n`).join('')
      return file('-rw-r--r--', new TextEncoder().encode(log).length, newestDate())
    }
    if (fakeScripts[name]) return file('-rwxr-xr-x', fakeScripts[name].join('\n').length + 1, '2024-04-01')
    if (dotfiles[name]) {
      const mode = name === '.bash_history' ? '-rw-------' : '-rw-r--r--'
      return file(mode, dotfiles[name].join('\n').length + 1, oldestDate())
    }
    return file('-rw-r--r--', 0, newestDate())
  }

  function entryLabel(dir: string, entry: Entry, trailingSlash: boolean) {
    const name = escapeHtml(entry.name)
    if (entry.kind === 'dir') {
      if (entry.name === '.' || entry.name === '..') return `<span class="dir">${name}</span>`
      const page = dirPage(`${dir}/${entry.name}`)
      const label = name + (trailingSlash ? '/' : '')
      return `<span class="dir">${page ? `<a href="${fs.langPrefix}${page}/" tabindex="-1">${label}</a>` : label}</span>`
    }
    return entry.name.endsWith('.md') && entry.name !== 'about.md' ? postLink(entry.name.slice(0, -3), entry.name) : name
  }

  // ls, ls -a, ls -l, ls -lah, ... over the fake file system
  function listing(dir: string, flags: Set<string> = new Set()) {
    const content = listDir(dir)!
    const all = flags.has('a')
    const entries: Entry[] = [
      ...(all ? (['.', '..'].map((name) => ({ name, kind: 'dir' })) as Entry[]) : []),
      ...(all ? (content.hidden || []).map((name): Entry => ({ name, kind: 'file' })) : []),
      ...content.dirs.map((name): Entry => ({ name, kind: 'dir' })),
      ...content.files.map((name): Entry => ({ name, kind: 'file' })),
    ]
    if (!entries.length) return

    if (!flags.has('l')) {
      const items = entries.map((entry) => entryLabel(dir, entry, true))
      // Long names one per line, short ones side by side
      if (entries.some((entry) => entry.name.length > 22)) items.forEach((item) => print(item))
      else print(items.join('  '))
      return
    }

    const human = flags.has('h')
    const rows = entries.map((entry) => ({ entry, ...stat(dir, entry) }))
    const sizeText = (bytes: number) => (human ? humanSize(bytes) : String(bytes))
    const linkWidth = Math.max(...rows.map((row) => String(row.links).length))
    const ownerWidth = Math.max(...rows.map((row) => row.owner.length))
    const sizeWidth = Math.max(...rows.map((row) => sizeText(row.size).length))
    // Disk usage in 1K blocks, rounded up to 4K blocks like most file systems
    const blocks = rows.reduce((sum, row) => sum + Math.ceil(row.size / 4096) * 4, 0)
    print(`total ${human ? humanSize(blocks * 1024) : blocks}`, 'pre')
    for (const row of rows) {
      const meta = [
        row.mode,
        String(row.links).padStart(linkWidth),
        row.owner.padEnd(ownerWidth),
        row.owner.padEnd(ownerWidth),
        sizeText(row.size).padStart(sizeWidth),
        lsDate(row.date),
      ].join(' ')
      print(`${escapeHtml(meta)} ${entryLabel(dir, row.entry, false)}`, 'pre')
    }
  }

  function journeyLog() {
    for (const post of fs.posts.slice(0, 5)) {
      print(`<span class="log-date">[${post.date}]</span> ${postLink(post.slug, post.title)}`)
    }
  }

  async function castleAge() {
    for (const row of fs.castle) {
      print(escapeHtml(row), 'castle')
      await wait(between(25, 50))
    }
  }

  async function mineBitcoin() {
    const output = [
      '[*] connecting to pool.balpars.local:3333 ... ok',
      '[*] warming up the CPU fan',
      '[*] hashrate: 0.0000042 H/s',
      '[!] estimated time to 1 BTC: 4.2 billion years',
      '[!] aborting. maybe read another post instead?',
    ]
    for (const line of output) {
      print(escapeHtml(line))
      await wait(between(450, 900))
    }
  }

  // Running ./castle_age.sh, ~/mine_bitcoin.sh, sh castle_age.sh, ...
  async function runScript(path: string): Promise<boolean> {
    const resolved = resolvePath(path, session.cwd)
    if (resolved === '~/castle_age.sh') await castleAge()
    else if (resolved === '~/mine_bitcoin.sh') await mineBitcoin()
    else return false
    return true
  }

  // What `cat` shows for the two scripts: plausible bash, entirely made up.
  // None of it runs; the "scripts" only ever print text.
  const fakeScripts: Record<string, string[]> = {
    'castle_age.sh': [
      '#!/usr/bin/env bash',
      '# castle_age.sh: advance to the Castle Age. defends the blog when attacked.',
      'set -euo pipefail',
      '',
      'FOOD=$(cat /var/lib/villagers/food 2>/dev/null || echo 0)',
      'GOLD=$(cat /var/lib/villagers/gold 2>/dev/null || echo 0)',
      '',
      'if (( FOOD < 800 || GOLD < 200 )); then',
      '  echo "not enough resources. read another post and try again." >&2',
      '  exit 1',
      'fi',
      '',
      'for wall in north east south west; do',
      '  build_wall "$wall" --material=stone --thickness=excessive',
      'done',
      '',
      '# the only intrusion detection system this blog has',
      'trap \'deploy_guards --count=4 --formation=line\' PATH_TRAVERSAL',
      '',
      'echo "castle age reached. wololo."',
    ],
    'mine_bitcoin.sh': [
      '#!/usr/bin/env bash',
      '# mine_bitcoin.sh: get rich while reading a blog. (you will not.)',
      'set -euo pipefail',
      '',
      'POOL="stratum+tcp://pool.balpars.local:3333"',
      'WALLET="bc1q-this-is-not-a-wallet-it-is-a-joke"',
      'THREADS=1          # be gentle with the reader\'s laptop',
      '',
      'connect "$POOL" --wallet "$WALLET" || true   # it never connects',
      '',
      'while true; do',
      '  nonce=$RANDOM',
      '  hash=$(echo "$nonce" | sha256sum | cut -c1-8)',
      '  [[ "$hash" == "00000000" ]] && break        # see you in 4.2 billion years',
      '  sleep 600                                  # about one block time',
      'done',
      '',
      'echo "mined 0.00000000 BTC. electricity bill: yours."',
    ],
  }

  // Aliases from ~/.bashrc; they work as commands too
  const aliases: Record<string, string> = {
    ll: 'ls -lah',
    please: 'sudo',
    hack: 'cat about.md',
  }
  const aliasComments: Record<string, string> = {
    please: "# still won't work",
  }
  const aliasLines = () =>
    Object.entries(aliases).map(([name, value]) => `alias ${name}='${value}'`)

  // Hidden files in ~, shown by `ls -a` and readable with cat. Also made up.
  const dotfiles: Record<string, string[]> = {
    '.bashrc': [
