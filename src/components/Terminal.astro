  const commands: Record<string, (args: string[]) => Promise<Result> | Result> = {
    help() {
      help.forEach((line) => print(escapeHtml(line) || '&nbsp;', 'pre'))
      return 'done'
    },
    async ls(args) {
      const flags = new Set<string>()
      const paths: string[] = []
      for (const arg of args) {
        if (arg === '--all') flags.add('a')
        else if (arg.startsWith('-') && arg.length > 1) {
          for (const flag of arg.slice(1)) {
            if (!'lah'.includes(flag)) {
              printError(`ls: invalid option -- '${flag}'`)
              print("this ls only knows -l, -a and -h. try 'ls -lah'.")
              return 'done'
            }
            flags.add(flag)
          }
        } else paths.push(arg)
      }
      const target = paths[0]
      const poke = target ? pokedOutside('ls', target) : null
      if (poke === 'attack') await guardResponds()
      if (poke) return 'done'
      const dir = resolvePath(target || '.', session.cwd)
      if (listDir(dir)) listing(dir, flags)
      else {
        const { dir: parent, name } = splitPath(dir)
        const parentContent = listDir(parent)
        // ls on a single file just names it
        if (parentContent?.files.includes(name) || parentContent?.hidden?.includes(name)) print(escapeHtml(target!))
        else printError(`ls: cannot access '${target}': No such file or directory`)
      }
      return 'done'
    },
    async cd(args) {
      const poke = args[0] ? pokedOutside('cd', args[0]) : null
      if (poke === 'attack') await guardResponds()
      if (poke) return 'done'
      const dir = resolvePath(args[0] || '~', session.cwd)
      if (!listDir(dir)) {
        const { dir: parent, name } = splitPath(dir)
        const isFile = listDir(parent)?.files.includes(name)
        printError(`cd: ${args[0]}: ${isFile ? 'Not a directory' : 'No such file or directory'}`)
        return 'done'
      }
      session.cwd = dir
      setTitle()
      const page = dirPage(dir)
      return page ? goTo(page) : 'done'
    },
    async cat(args) {
      if (!args[0]) {
        printError('cat: missing file (try ls)')
        return 'done'
      }
      const poke = pokedOutside('cat', args[0])
      if (poke === 'attack') await guardResponds()
      if (poke) return 'done'
      const path = resolvePath(args[0], session.cwd)
      if (listDir(path)) {
        printError(`cat: ${args[0]}: Is a directory`)
        return 'done'
      }
      const { dir, name } = splitPath(path)
      const content = listDir(dir)
      if (!content?.files.includes(name) && !content?.hidden?.includes(name)) {
        printError(`cat: ${args[0]}: No such file or directory`)
        return 'done'
      }
      if (path === '~/about.md') return goTo('/about')
      if (path === '~/journey.log') journeyLog()
      else if (dotfiles[name]) printScript(dotfiles[name])
      else if (name.endsWith('.sh')) printScript(fakeScripts[name] || [])
      else return goTo(`/posts/${name.slice(0, -3)}`)
      return 'done'
    },
    pwd() {
      print(escapeHtml('/home/balpars' + session.cwd.slice(1)))
      return 'done'
    },
    clear() {
      clearScreen()
      return 'done'
    },
    whoami() {
      print('guest. a curious reader, probably.')
      return 'done'
    },
    echo(args) {
      print(escapeHtml(args.join(' ')))
      return 'done'
    },
    tail(args) {
      if (resolvePath(args[args.length - 1] || '', session.cwd) === '~/journey.log') journeyLog()
      else printError('tail: only journey.log is worth tailing here')
      return 'done'
    },
    theme(args) {
      const current = document.documentElement.getAttribute('data-theme') || ''
      if (!fs.themes.length) {
        print('this site has exactly one theme. it is perfect.')
      } else if (!args[0]) {
        print(escapeHtml(`current theme: ${current}`))
        print('usage: theme &lt;name&gt; | theme list')
      } else if (args[0] === 'list') {
        print(escapeHtml(fs.themes.join('  ')))
      } else if (fs.themes.includes(args[0])) {
        quietThemeChange = true
        document.documentElement.setAttribute('data-theme', args[0])
        localStorage.setItem('data-theme', args[0])
      } else {
        printError(`theme: unknown theme '${args[0]}' (try theme list)`)
      }
      return 'done'
    },
    sh(args) {
      return runScript(args[0] || '').then((ran) => {
        if (!ran) printError(`sh: ${args[0] || ''}: No such file or directory`)
        return 'done' as Result
      })
    },
  }

  // Readers of a security blog will poke at the "system". Answer in kind.
  // Returns 'attack' (the castle guard reacts), 'joke', or null for normal handling.
  // What the guard charges the intruder with, set by pokedOutside()
  let crime = 'poking at the castle walls'

  function pokedOutside(command: string, arg: string): 'attack' | 'joke' | null {
    const say = (text: string) => print(escapeHtml(text), 'pre')
    const attack = (charge: string) => {
      crime = charge
      return 'attack' as const
    }
    // ../../.. that climbs above home: the classic web attack, on a static site
    let climbed = false
    if (!arg.startsWith('/') && !arg.startsWith('~')) {
      let depth = session.cwd === '~' ? 0 : session.cwd.split('/').length - 1
      for (const part of arg.split('/')) {
        if (part === '..') depth--
        else if (part && part !== '.') depth++
        if (depth < 0) climbed = true
      }
    }
    if (climbed) printError(`${command}: ${arg}: path traversal detected`)
    if (/(^|\/)etc\/passwd$/.test(arg)) {
      say(
        [
          'root:x:0:0:definitely not you:/root:/usr/sbin/nologin',
          'balpars:x:1000:1000:the author:/home/balpars:/bin/balpars-sh',
          'guest:x:1001:1001:a curious reader:/home/balpars:/bin/balpars-sh',
          'castle_guard:x:1337:1337:watches for path traversal:/castle:/bin/false',
        ].join('\n'),
      )
      return attack(
        climbed
          ? 'path traversal on a static blog hosted on GitHub Pages'
          : 'reading /etc/passwd on a website that has no server',
      )
    }
    if (/(^|\/)etc\/shadow$/.test(arg)) {
      printError(`${command}: ${arg}: Permission denied. the hashes are salted with tears anyway.`)
      return attack('going after password hashes that were never there')
    }
    if (/\.ssh|id_rsa|id_ed25519/.test(arg)) {
      print(
        `${escapeHtml(command)}: the only key on this blog is the one from ` +
          `${postLink('diffie-hellman-key-exchange', 'Diffie-Hellman')}. go read it instead.`,
      )
      return attack('looking for private keys in a public repo')
    }
    if (/(^|\/)\.env$/.test(arg)) {
      say('SECRET_KEY=hunter2\n# just kidding. there are no secrets in a static site.')
      return attack('hunting for secrets in plain HTML')
    }
    if (/(^|\/)flag(\.txt)?$/i.test(arg)) {
      say('FLAG{th3_r34l_fl4g_w4s_th3_p0sts_w3_r34d_4l0ng_th3_w4y}')
      return 'joke'
    }
    if (climbed) return attack('path traversal on a static blog hosted on GitHub Pages')
    // Absolute paths outside home (/etc, /root, /proc, ...)
    if (arg.startsWith('/') && arg !== '/') {
      printError(`${command}: ${arg}: this shell is chrooted to ~. there is nothing above home.`)
      return attack('trying to escape a chroot that is made of JavaScript')
    }
    return null
  }

  // The castle guard answers an attack: the castle is printed, then soldiers
  // march out of the gate and spread into a line. Animated in place.
  async function guardResponds() {
    await wait(350)
    print('<span class="error">[!] intrusion attempt. the castle guard is on its way.</span>')
    await castleAge()
    const soldier = [' o ', '/|\\', '/ \\']
    const frames = [[10], [7, 13], [4, 10, 16], [1, 7, 13, 19]]
    const army = (cols: number[]) =>
      soldier
        .map((row) => {
          let line = ' '.repeat(24)
          for (const col of cols) line = line.slice(0, col) + row + line.slice(col + row.length)
          return line.trimEnd()
        })
        .join('\n')
    const line: Line = { kind: 'out', html: '', cls: 'castle soldiers' }
    session.lines.push(line)
    const element = lineElement(line)
    screen?.append(element)
    for (const cols of frames) {
      line.html = escapeHtml(army(cols))
      element.innerHTML = line.html
      scrollToEnd()
      await wait(320)
    }
    print(`<span class="error">[guard] intruder repelled. found guilty of ${escapeHtml(crime)}.</span>`)
  }

