---
import IconChevronsRight from '~/icons/chevrons-right.svg'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import Tags from '~/components/Tags.astro'
import PostInfo from '~/components/PostInfo.astro'
import type { Collation } from '~/types'
import { TagsGroup, postUrl } from '~/utils'
import { getLangFromUrl, t } from '~/i18n'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const lang = getLangFromUrl(Astro.url)

const { remarkPluginFrontmatter } = await render(post)
const description = remarkPluginFrontmatter.description || post.data.description
let tags: Collation<'posts'>[] | undefined
if (post.data.tags && post.data.tags.length > 0) {
  const tagsGroup = await TagsGroup.build(undefined, lang)
  tags = tagsGroup.matchMany(post.data.tags)
}
const postLink = postUrl(post, lang)
const samePage = Astro.url.pathname.replace(/\/$/, '') === postLink.replace(/\/$/, '')
const articleLink = samePage ? `#${post.id}` : postLink
---

<article class="w-full py-5 my-1 md:my-4 border-accent/10">
  <h2 class="mb-3 text-2xl text-heading1 font-semibold">
    <a href={articleLink}><span class="text-accent/80" aria-hidden="true"># </span>{post.data.title}</a>
  </h2>
  <PostInfo post={post} class="mb-3 mt-4" />
  {description && <p class="pl-0.5 my-4 text-base/7 text-foreground">{description}</p>}
  {
    tags && (
      <div class="mb-6">
        <Tags tags={tags} />
      </div>
    )
  }
  <div>
    <a class="button flex items-center !pl-3.5" href={articleLink}>
      {samePage ? t(lang, 'post.continue') : t(lang, 'post.read')}
      <IconChevronsRight class="size-5 ml-2" />
    </a>
  </div>
</article>
