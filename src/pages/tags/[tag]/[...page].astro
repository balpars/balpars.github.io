---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { tagPaths } from '~/staticPaths'
import { getLangFromUrl, t, tagLabel } from '~/i18n'
import { truncate } from '~/seo'
import Pagination from '~/components/Pagination.astro'
import PostPreview from '~/components/PostPreview.astro'

export const getStaticPaths = (async ({ paginate }) => {
  return tagPaths(paginate, 'en')
}) satisfies GetStaticPaths

const { page, tagTitle } = Astro.props
const lang = getLangFromUrl(Astro.url)
const tagName = tagLabel(tagTitle, lang)
const pageTitle =
  `${t(lang, 'tag.title')}: ${tagName}` +
  (page.currentPage > 1 ? ` - ${t(lang, 'pagination.page')} ${page.currentPage}` : '')
---

<!-- Tag pages repeat the posts' own previews, so they stay out of search results -->
<Layout
  title={pageTitle}
  description={truncate(
    t(lang, 'tag.description', {
      name: tagName,
      titles: page.data.map((post) => post.data.title).join('; '),
    }),
  )}
  noindex
>
  <div class="mt-2 sm:mt-0">
    <h1 class="sr-only">{`${t(lang, 'tag.title')}: ${tagName}`}</h1>
    {page.data.map((post) => <PostPreview post={post} />)}
    <Pagination
      prevLink={page.url.prev ? encodeURI(page.url.prev) : undefined}
      prevText={t(lang, 'pagination.newer')}
      nextLink={page.url.next ? encodeURI(page.url.next) : undefined}
      nextText={t(lang, 'pagination.older')}
    />
  </div>
</Layout>
