---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { seriesPaths } from '~/staticPaths'
import { getLangFromUrl, seriesLabel, t } from '~/i18n'
import { truncate } from '~/seo'
import PostPreview from '~/components/PostPreview.astro'

export const getStaticPaths = (async () => {
  return seriesPaths('en')
}) satisfies GetStaticPaths

const { posts, seriesTitle } = Astro.props
const lang = getLangFromUrl(Astro.url)
const seriesName = seriesLabel(seriesTitle, lang)
---

<Layout
  title={`${t(lang, 'series.title')}: ${seriesName}`}
  description={truncate(
    t(lang, 'series.description', {
      name: seriesName,
      titles: posts.map((post) => post.data.title).join('; '),
    }),
  )}
>
  <div class="mt-2 sm:mt-0">
    <h1 class="sr-only">{`${t(lang, 'series.title')}: ${seriesName}`}</h1>
    {posts.map((post) => <PostPreview post={post} />)}
  </div>
</Layout>
