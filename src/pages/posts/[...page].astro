---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/Pagination.astro'
import PostPreview from '~/components/PostPreview.astro'
import BlockHeader from '~/components/BlockHeader.astro'
import TagsSection from '~/components/TagsSection.astro'
import { getSortedPosts } from '~/utils'
import { archivePaths } from '~/staticPaths'
import { getLangFromUrl, t } from '~/i18n'

export const getStaticPaths = (async ({ paginate }) => {
  return archivePaths(paginate, 'en')
}) satisfies GetStaticPaths

const { page } = Astro.props
const lang = getLangFromUrl(Astro.url)
const allPosts = await getSortedPosts(lang)
const postsHaveTags = allPosts.some((post) => post.data.tags && post.data.tags.length > 0)
const pageTitle =
  t(lang, 'archive.title') +
  (page.currentPage > 1 ? ` - ${t(lang, 'pagination.page')} ${page.currentPage}` : '')
---

<Layout title={pageTitle} description={t(lang, 'archive.description')}>
  <div class="mt-2 sm:mt-0">
    {page.data.map((post) => <PostPreview post={post} />)}
    <Pagination
      prevLink={page.url.prev ? page.url.prev : undefined}
      prevText={t(lang, 'pagination.newer')}
      nextLink={page.url.next ? page.url.next : undefined}
      nextText={t(lang, 'pagination.older')}
    />
    {
      postsHaveTags && (
        <section>
          <BlockHeader>{t(lang, 'home.tags')}</BlockHeader>
          <TagsSection posts={allPosts} />
        </section>
      )
    }
  </div>
</Layout>
